# Backend server settings
AETHEROS_HOST=0.0.0.0
AETHEROS_PORT=8000
AETHEROS_BACKEND_DIR=./backend

# Android emulator uses 10.0.2.2 to reach the host machine.
# Physical Android devices should use your computer LAN IP, for example http://192.168.1.20:8000.
AETHEROS_API_BASE_URL=http://10.0.2.2:8000
AETHEROS_MOBILE_DIR=./mobile
